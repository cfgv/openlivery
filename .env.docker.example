# PostgreSQL inside Docker. Use only letters and numbers in the password so the URL stays valid.
POSTGRES_DB=openlivery
POSTGRES_TEST_DB=openlivery_test
POSTGRES_USER=openlivery
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Secrets unique to this installation. Do not reuse values across installations.
SECRET_KEY=CHANGE_THIS_SESSION_SECRET
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY
WHATSAPP_BRIDGE_TOKEN=CHANGE_THIS_INTERNAL_TOKEN

# Public addresses opened by the user's browser.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional configuration.
ACCESS_TOKEN_MINUTES=10080
WHATSAPP_LOG_LEVEL=silent

# Session cookie flags. Behind HTTPS set COOKIE_SECURE=true. If the frontend and
# API are served from different sites, set COOKIE_SAMESITE=none (needs COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Host ports. Change any that clash with other local services.
# If you change API_PORT, also update NEXT_PUBLIC_API_URL above (or use `make up`).
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (expose on a server).
BIND_HOST=127.0.0.1
